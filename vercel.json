{
    "crons": [
        {
            "path": "/api/cron/keep-alive",
            "schedule": "0 0 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/cdn-images/:path*",
            "destination": "https://qigrfrfvtlmvymuqodxw.supabase.co/storage/v1/object/public/products/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/cdn-images/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}